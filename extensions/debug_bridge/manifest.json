{
  "action": {
    "default_icon": {
      "16": "img/icon-16x16.png",
      "32": "img/icon-32x32.png"
    },
    "default_title": "Arm Debug Bridge for this tab"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "description": "Run JavaScript in the armed browser tab from a terminal, through a local server. Keep it off except while debugging.",
  "host_permissions": [
    "http://localhost:8765/*"
  ],
  "icons": {
    "128": "img/icon-128x128.png",
    "16": "img/icon-16x16.png",
    "32": "img/icon-32x32.png",
    "48": "img/icon-48x48.png"
  },
  "manifest_version": 3,
  "name": "Debug Bridge",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "storage"
  ],
  "version": "0.0.1"
}
